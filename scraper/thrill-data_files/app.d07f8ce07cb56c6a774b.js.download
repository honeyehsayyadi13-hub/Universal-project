  if (signals?.timezone_country_mismatch) return 'tzmm';

  return 'normal';
}

function getFailUrl(options, type) {
  return `${options.failUrlBase || ''}/ext/partner/fail/${type}`;
}

function reportFingerprintFailure(options, msg) {
  const request = {
    data: {
      aid: options.aid,
      habl: options.userData.hasAdblocker,
      isinc: options.userData.isInc,
      msg,
      product: options.product,
    },
    method: 'GET',
    url: getFailUrl(options, 'fp'),
  };

  if (options.product === 'map') {
    request.queryType = ['failfp'];
  }

  options.ajax(request);
}

function reportThumbmarkFailure(options, error) {
  const request = {
    data: {
      aid: options.aid,
      component: error.component,
      habl: options.userData.hasAdblocker,
      isinc: options.userData.isInc,
      msg: error.message,
      product: options.product,
      type: error.type,
    },
    method: 'GET',
    url: getFailUrl(options, 'tm'),
  };

  if (options.product === 'map') {
    request.queryType = ['failtm'];
  }

  options.ajax(request);
}

async function setFootprint(options) {
  const { devLog, isProd, readLSE, saveToLSE, userData } = options;

  // if the ip is changed, disregard the current sid22 and just force a new one so thumbmark can train knowing it's the same user
  const fingerprint =
    readLSE(FINGERPRINT_IP_HASH_KEY) !== userData.hip22 ? null : readLSE('sid22'); // strictly from ls

  if (userData.isBot) {
    // Session ID and fingerprint type are already set by the caller/backend
    userData.conMeth = null;
  } else if (fingerprint) {
    userData.sessionID = fingerprint;
    userData.conMeth = validateConnectionMethod(readLSE('conMeth'));
    userData.fpType = getFingerprintType(fingerprint);

    if (userData.conMeth === 'bot') {
      // double check
      userData.isBot = true;
    }
  } else {
    // new or expired session
    try {
      const thumbmarkOptions = {
        api_endpoint: isProd ? 'https://id.h2.stay22.com/collect' : 'https://id-staging.h2.stay22.com/collect',
        property_name_factory: (name) => `${name}_id22`,
        stabilize: ['private', 'iframe'],
        timeout: 6000,
        simple_request: true,
      };

      // for test purposes, it uses `createThumbmark` to allow injection of a mock Thumbmark instance. In production, it will create a real Thumbmark instance.
      const thumbmark = options.createThumbmark
        ? options.createThumbmark(thumbmarkOptions)
        : new options.Thumbmark(thumbmarkOptions);

      const fingerprintResponse = await thumbmark.get();

      if (fingerprintResponse.visitorId) {
        userData.sessionID = fingerprintResponse.visitorId;
        userData.conMeth = getConnectionMethodFromThumbmarkResponse(fingerprintResponse);
        userData.fpType = 'vid';

        // still prevalent for like 0.1% of users somehow sneaks in
        if (userData.conMeth === 'bot') {
          userData.isBot = true;
        }

        saveToLSE('conMeth', userData.conMeth, FINGERPRINT_LSE_DAYS);
      } else if (fingerprintResponse.thumbmark) {
        if (devLog) {
          devLog(fingerprintResponse);
        }

        // if somehow the thumbmarkjs api is down but not the fingerprinting
        userData.sessionID = fingerprintResponse.thumbmark;
        userData.conMeth = null;
        userData.fpType = 'bfp';

        // report the error
        reportFingerprintFailure(options, 'vidreq_failed');
      } else {
        // here is a case both failed, and it actually returns ""
        if (devLog) {
          devLog(fingerprintResponse);
        }

        // Session ID and fingerprint type are already set by the caller/backend
        userData.conMeth = null;

        // report the error
        reportFingerprintFailure(options, 'all_failed');
      }

      // report thumbmarkjs errors separately, as they could happen regardless
      //  if there's a VID or not due to come component failling
      if (fingerprintResponse.error && fingerprintResponse.error.length) {
        if (devLog) {
          devLog(fingerprintResponse.error);
        }

        // we report only the first one
        reportThumbmarkFailure(options, fingerprintResponse.error[0]);
      }
    } catch (e) {
      if (devLog) {
        devLog(e);
      }

      // Session ID and fingerprint type are already set by the caller/backend
      userData.conMeth = null;

      // report the error
      reportFingerprintFailure(options, 'trycatch_failed');
    }
  }

  // always save it, even the bad ones
  saveToLSE('sid22', userData.sessionID, FINGERPRINT_LSE_DAYS);
  saveToLSE(FINGERPRINT_IP_HASH_KEY, userData.hip22, FINGERPRINT_LSE_DAYS);
}

module.exports = {
  CONNECTION_METHODS,
  FINGERPRINT_IP_HASH_KEY,
  FINGERPRINT_LSE_DAYS,
  getConnectionMethodFromThumbmarkResponse,
  getFingerprintType: getFingerprintType,
  isConnectionMethod,
  setFootprint,
  validateConnectionMethod,
};


